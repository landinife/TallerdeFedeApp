rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿El correo de quien entra figura en la lista de acceso de ese taller?
    function invitado(uid) {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/accesos/$(uid))
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/accesos/$(uid)).data.emails;
    }

    // Datos del taller: la cuenta dueña y las cuentas invitadas
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || invitado(uid));
    }

    // Lista de correos con acceso: solo la cuenta dueña
    match /accesos/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Aviso para la cuenta invitada: lo lee el invitado, lo escribe la dueña
    match /invitaciones/{email} {
      allow read: if request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
      allow create, update: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email.lower();
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
